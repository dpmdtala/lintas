<script>
const LOGO_DPMD='data:image/png;base64,';
const LOGO_TANAH_LAUT='data:image/png;base64,';
const OFFICIAL_PHOTOS=['data:image/webp;base64,','data:image/webp;base64,','data:image/webp;base64,','data:image/webp;base64,','data:image/webp;base64,','data:image/webp;base64,','data:image/webp;base64,'];
let allIncoming=[], allOutgoing=[], sessionToken='', currentRole='';
let foStatusSnapshot={}, foPollingStarted=false;
document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>switchTab(b.dataset.tab)));
function switchTab(tab){document.querySelectorAll('.recap-print-actions').forEach(el=>{el.style.display=(tab==='fo-list'&&currentRole==='FRONT_OFFICE')?'flex':'none';});
  const foTabs=['incoming','fo-list','performance','visitors','ikm'];
  const adminTabs=['archive','outgoing','recap-incoming','recap-outgoing','recap-cards'];
  if(foTabs.includes(tab)&&currentRole!=='FRONT_OFFICE')return;
  if(adminTabs.includes(tab)&&currentRole!=='ADMIN_SURAT')return;
  document.querySelectorAll('[data-tab]').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));
  [...foTabs,...adminTabs].forEach(t=>{const el=document.getElementById('tab-'+t);if(el)el.classList.toggle('hidden',t!==tab);});
  if(tab==='fo-list'){loadFoIncoming();const b=document.getElementById('foStatusBadge');if(b)b.classList.add('hidden');}
  if(tab==='archive')loadIncoming();
  if(tab==='outgoing'||tab==='recap-outgoing')loadOutgoing();
  if(tab==='recap-incoming')applyIncomingRecap();
  if(tab==='recap-cards')applyCardRecap();
}
function showNotice(msg,type='success'){const n=document.getElementById('notice');n.textContent=msg;n.className='notice '+(type==='error'?'error':'success');n.classList.remove('hidden');window.scrollTo({top:0,behavior:'smooth'});}
function serverCall(fn,...args){if(typeof google==='undefined'||!google.script||!google.script.run){return Promise.reject(new Error('LINTAS belum dibuka melalui alamat Web App Google Apps Script. Buka URL dari Deploy → Manage deployments, bukan file HTML lokal atau pratinjau.'));}if(!['login','logout'].includes(fn))args.push(sessionToken);return new Promise((resolve,reject)=>{const runner=google.script.run.withSuccessHandler(resolve).withFailureHandler(e=>reject(new Error(e.message||String(e))));if(typeof runner[fn]!=='function'){reject(new Error('Fungsi '+fn+' tidak ditemukan. Simpan Code.gs dan deploy versi terbaru.'));return;}runner[fn](...args);});}
function togglePinVisibility(){const input=document.getElementById('loginPin');const btn=document.getElementById('togglePin');const showing=input.type==='password';input.type=showing?'text':'password';btn.textContent=showing?'🙈':'👁';btn.setAttribute('aria-label',showing?'Sembunyikan PIN':'Tampilkan PIN');btn.title=showing?'Sembunyikan PIN':'Tampilkan PIN';input.focus();}
function openLogin(role){const roleEl=document.getElementById('loginRole'),label=document.getElementById('loginRoleLabel'),panel=document.getElementById('loginPanel'),pin=document.getElementById('loginPin');if(!roleEl||!label||!panel||!pin){console.error('Komponen login tidak lengkap', {role:!!roleEl,label:!!label,panel:!!panel,pin:!!pin});alert('Form login tidak termuat lengkap. Muat ulang halaman aplikasi.');return;}roleEl.value=role;label.textContent=role==='FRONT_OFFICE'?'Masuk sebagai Front Office':'Masuk sebagai Pengadministrasi Surat';panel.classList.remove('hidden');panel.style.display='grid';pin.focus();}
function closeLogin(){const panel=document.getElementById('loginPanel'),pin=document.getElementById('loginPin');if(panel){panel.classList.add('hidden');panel.style.display='none';}if(pin)pin.value='';}
document.getElementById('loginForm').addEventListener('submit',async e=>{e.preventDefault();const b=document.getElementById('loginBtn');b.disabled=true;try{const r=await serverCall('login',(document.getElementById('loginRole')||{value:'FRONT_OFFICE'}).value,(document.getElementById('loginPin')||{value:''}).value);sessionToken=r.token;currentRole=r.role;if(document.getElementById('loginPin'))document.getElementById('loginPin').value='';closeLogin();document.getElementById('landingPanel').classList.add('hidden');document.getElementById('appPanel').classList.remove('hidden');applyRoleView();refreshAll();startFoStatusPolling();}catch(err){alert(err.message);}finally{b.disabled=false;}});

function applyRoleView(){
  const isAdmin=currentRole==='ADMIN_SURAT';
  const roleLabel=document.getElementById('activeRoleLabel'); if(roleLabel) roleLabel.textContent=isAdmin?'Pengadministrasi Perkantoran':'Front Office';
  const roleHint=document.getElementById('activeRoleHint'); if(roleHint) roleHint.textContent='';
  updateWelcomeGreeting();
  renderOfficials();
  document.querySelectorAll('.front-office-only').forEach(el=>el.classList.toggle('hidden',isAdmin));
  document.querySelectorAll('.admin-only').forEach(el=>el.classList.toggle('hidden',!isAdmin));
  // Kartu ringkasan surat masuk tetap tampil pada kedua peran.
  document.querySelectorAll('.incoming-only').forEach(el=>el.classList.remove('hidden'));
  const firstTab=isAdmin?'archive':'incoming';
  document.querySelectorAll('[data-tab]').forEach(b=>b.classList.toggle('active',b.dataset.tab===firstTab));
  ['incoming','fo-list','performance','visitors','ikm','outgoing','archive','recap-incoming','recap-outgoing','recap-cards'].forEach(t=>{const el=document.getElementById('tab-'+t);if(el)el.classList.toggle('hidden',t!==firstTab);});
}
async function logoutCurrentRole(){document.body.classList.remove('app-active');
  const btn=document.getElementById('logoutBtn');btn.disabled=true;
  try{if(sessionToken) await serverCall('logout',sessionToken);}
  catch(e){/* tetap bersihkan sesi lokal agar pengguna bisa keluar */}
  sessionToken='';currentRole='';allIncoming=[];allOutgoing=[];
  document.getElementById('appPanel').classList.add('hidden');
  document.getElementById('landingPanel').classList.remove('hidden');
  document.getElementById('notice').classList.add('hidden');
  if(document.getElementById('loginPin'))document.getElementById('loginPin').value='';
  btn.disabled=false;
}
const OFFICIALS=[
 {title:'Kepala Dinas',name:'MOHAMMAD SYAHID, S.STP, M.AP',nip:'19790629 200003 1 004',cls:'kadis'},
 {title:'Sekretaris',name:'YUDO RESTANTO, S.STP, M.IP',nip:'198609012004121002',cls:'pimpinan'},
 {title:'Kepala Bidang Bina Pemberdayaan Masyarakat',name:'ADY TASADA KESUMA TAHJI, S.Gz, M.M',nip:'19700915 199203 1 009',cls:'pimpinan'},
 {title:'Kepala Bidang Bina Pemerintahan Desa',name:'FEBRIAN NOVIEAR A.R, S.H., M.A',nip:'19861013 201502 1 001',cls:'pimpinan'},
 {title:'Kepala Bidang Bina Perencanaan, Keuangan, Aset, Evaluasi dan Data Desa',name:'INDRA WARDHANA, S.STP',nip:'19831106 200212 1 001',cls:'pimpinan'},
 {title:'Kepala Sub Bagian Umum dan Kepegawaian',name:'SUBI HARTATI, ST',nip:'19690421 200701 2 032',cls:'kasub'},
 {title:'Kepala Sub Bagian Perencanaan dan Keuangan',name:'ACHMAD SYAFARIADI, SE',nip:'19720329 200801 1 010',cls:'kasub'}
];
function updateWelcomeGreeting(serverDateText){document.body.classList.add('app-active');let h=new Date().getHours();if(serverDateText){const m=serverDateText.match(/(\d{2}):(\d{2}):(\d{2})/);if(m)h=Number(m[1]);}const greet=h<11?'Selamat Pagi':h<15?'Selamat Siang':h<18?'Selamat Sore':'Selamat Malam';const admin=currentRole==='ADMIN_SURAT';const name=admin?'TAMIRAH':'(NAMA PETUGAS FRONT OFFICE)';const role=admin?'PENGADMINISTRASI PERKANTORAN':'FRONT OFFICER';const el=document.getElementById('welcomeLine');if(el)el.innerHTML=`${greet}, ${role}: <span class="welcome-name">${name}</span>, SELAMAT BEKERJA!`;}
function renderOfficials(){const root=document.getElementById('officialsList');if(!root)return;const heading=document.getElementById('officialsHeading');if(heading){const now=new Date();heading.textContent='Informasi Pejabat Hari Ini ('+String(now.getDate()).padStart(2,'0')+':'+String(now.getMonth()+1).padStart(2,'0')+':'+now.getFullYear()+')';}serverCall('getOfficialStatuses').then(rows=>{root.innerHTML=(rows||[]).map((o,i)=>{const cls=i===0?'kadis':i>=5?'kasub':'pimpinan';const st=o.status||'Belum diperbarui';const opts=['Ada di kantor','Keluar','Istirahat','Dinas luar','Izin','Sakit','Cuti','Belum diperbarui'];return `<div class="official-card ${cls}"><div class="official-top"><div class="official-photo"><img loading="lazy" decoding="async" src="${OFFICIAL_PHOTOS[i]||''}" alt="Foto ${escapeHtml(o.name)}"></div><div><div class="official-name">${escapeHtml(o.name)}</div><div class="official-title">${escapeHtml(o.title)}</div><div class="official-title">NIP. ${escapeHtml(o.nip)}</div></div></div><div class="official-status"><label>Status keberadaan</label><select id="officialStatus${escapeHtml(o.id)}" ${currentRole!=='FRONT_OFFICE'?'disabled':''}>${opts.map(v=>`<option ${st===v?'selected':''}>${v}</option>`).join('')}</select>${currentRole==='FRONT_OFFICE'?`<button type="button" onclick="saveOfficialStatus('${escapeJs(o.id)}')">Simpan Status</button>`:''}</div></div>`}).join('');}).catch(e=>{root.innerHTML='<p class="muted">Status pejabat belum tersedia. Jalankan setup database lalu muat ulang.</p>';});}
async function saveOfficialStatus(id){const el=document.getElementById('officialStatus'+id);if(!el)return;try{await serverCall('saveOfficialStatus',id,el.value);showNotice('Status keberadaan pejabat berhasil disimpan dan dapat dilihat oleh kedua peran.');renderOfficials();}catch(e){showNotice(e.message,'error');}}
function openVisitorLink(){const u=(document.getElementById('visitorFormUrl')?.value||'').trim();if(!u){showNotice('Masukkan tautan formulir tamu terlebih dahulu.','error');return;}window.open(u,'_blank','noopener');}
async function copyVisitorLink(){const u=(document.getElementById('visitorFormUrl')?.value||'').trim();if(!u){showNotice('Masukkan tautan formulir tamu terlebih dahulu.','error');return;}try{await navigator.clipboard.writeText(u);showNotice('Tautan formulir tamu berhasil disalin.')}catch(e){showNotice('Tidak dapat menyalin otomatis. Salin tautan dari kolom formulir.','error')}}
function submitIkmDraft(e){e.preventDefault();const f=new FormData(e.target);const vals=['kecepatan','kemudahan','kesopanan','kepuasan'].map(k=>Number(f.get(k)));const avg=vals.reduce((a,b)=>a+b,0)/vals.length;const box=document.getElementById('ikmDraftResult');box.textContent='Pratinjau berhasil dibuat. Rata-rata nilai 4 unsur: '+avg.toFixed(2)+' dari 4. Data belum tersimpan ke database; ini masih formulir rancangan.';box.className='notice success';box.classList.remove('hidden');}
function setTodayForwardDate(){const el=document.getElementById('tanggalDiteruskanFO');if(el){const d=new Date();el.value=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}}
setTodayForwardDate();
function refreshAll(){serverCall('getInitialData').then(d=>{const clockEl=document.getElementById('clock');if(clockEl)clockEl.textContent='Waktu server: '+d.serverNow;updateWelcomeGreeting(d.serverNow);const setText=(id,v)=>{const el=document.getElementById(id);if(el)el.textContent=v??0;};setText('mToday',d.counts.incomingToday);setText('mTodayAdmin',d.counts.incomingToday);setText('mOutgoingToday',d.counts.outgoingToday);setText('mMonth',d.counts.incomingMonth);setText('mIncoming',d.counts.incomingTotal);setText('mOutgoing',d.counts.outgoingTotal);setText('mVisitorsToday',d.counts.visitorsToday);setText('mIkmTotal',d.counts.ikmToday);setText('mSatisfactionToday',d.counts.satisfactionToday);setText('mFoMonth',d.counts.incomingMonth);allIncoming=d.incoming||[];allOutgoing=d.outgoing||[];populateYears();renderIncoming(allIncoming);renderOutgoing(allOutgoing);if(currentRole==='FRONT_OFFICE')loadFoIncoming();else if(currentRole==='ADMIN_SURAT'){loadIncoming();loadOutgoing();}}).catch(e=>showNotice(e.message,'error'));}
function startFoStatusPolling(){if(foPollingStarted)return;foPollingStarted=true;window.setInterval(()=>{if(currentRole==='FRONT_OFFICE'&&sessionToken)checkFoStatusChanges();},30000);}
function checkFoStatusChanges(){serverCall('listIncoming',{limit:5000}).then(rows=>{rows=rows||[];let changed=[];const next={};rows.forEach(r=>{const id=String(r.ID_Surat||'');const st=String(r.Status||'');next[id]=st;if(foStatusSnapshot[id]&&foStatusSnapshot[id]!==st)changed.push({record:r,old:foStatusSnapshot[id],now:st});});if(Object.keys(foStatusSnapshot).length&&changed.length){const badge=document.getElementById('foStatusBadge');badge.textContent=changed.length>9?'9+':String(changed.length);badge.classList.remove('hidden');const names=changed.slice(0,3).map(x=>(x.record.Nomor_Registrasi||'Surat')+': '+x.now);showNotice('Pembaruan status surat: '+names.join(' | ')+(changed.length>3?' dan '+(changed.length-3)+' surat lainnya.':''));}foStatusSnapshot=next;allIncoming=rows;applyFoFilters();}).catch(()=>{});}
function loadFoIncoming(){serverCall('listIncoming',{limit:5000}).then(r=>{allIncoming=r||[];if(!Object.keys(foStatusSnapshot).length)allIncoming.forEach(x=>foStatusSnapshot[String(x.ID_Surat||'')]=String(x.Status||''));applyFoFilters();}).catch(e=>showNotice(e.message,'error'));}
function applyFoFilters(){const q=(document.getElementById('foSearchQ')?.value||'').trim().toLocaleLowerCase('id');const exact=document.getElementById('foDate')?.value||'';const from=document.getElementById('foFrom')?.value||'';const to=document.getElementById('foTo')?.value||'';const rows=allIncoming.filter(r=>{const d=String(r.Tanggal_Diterima||'');const text=['Nomor_Registrasi','Nomor_Surat','Asal_Surat','Perihal'].some(k=>String(r[k]||'').toLocaleLowerCase('id').includes(q));return text&&(!exact||d===exact)&&(!from||d>=from)&&(!to||d<=to);});renderIncoming(rows,'foIncomingTable');}
function clearFoFilters(){['foSearchQ','foDate','foFrom','foTo'].forEach(id=>{const e=document.getElementById(id);if(e)e.value='';});applyFoFilters();}
function openSiapLink(){const url=((document.getElementById('siapUrl')||{value:''}).value||'').trim();if(!/^https?:\/\//i.test(url)){showNotice('Masukkan alamat resmi SIAP yang valid terlebih dahulu.','error');return;}window.open(url,'_blank','noopener');}
function showDailyActivitySummary(){const now=new Date();const today=now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0')+'-'+String(now.getDate()).padStart(2,'0');const rows=allIncoming.filter(r=>String(r.Tanggal_Diterima||'')===today);const target=document.getElementById('dailyActivitySummary');target.textContent='Ringkasan LINTAS hari ini: '+rows.length+' surat masuk tercatat. Ringkasan ini belum dikirim otomatis ke SIAP.';target.classList.remove('hidden');}
function populateYears(){const sel=document.getElementById('filterYear');const years=new Set();allIncoming.forEach(r=>{if(r.Tanggal_Diterima)years.add(String(r.Tanggal_Diterima).slice(0,4));});const current=sel.value;sel.innerHTML='<option value="">Semua tahun</option>'+[...years].sort().reverse().map(y=>`<option value="${escapeHtml(y)}">${escapeHtml(y)}</option>`).join('');sel.value=current;}
function readFile(file){return new Promise((resolve,reject)=>{if(!file)return reject(new Error('Hasil scan wajib dilampirkan.'));if(file.size>10*1024*1024)return reject(new Error('Ukuran file maksimal 10 MB.'));const allowed=['application/pdf','image/jpeg','image/png'];if(!allowed.includes(file.type))return reject(new Error('Format file harus PDF, JPG, atau PNG.'));const reader=new FileReader();reader.onload=()=>resolve({name:file.name,mimeType:file.type,base64:String(reader.result).split(',')[1]});reader.onerror=()=>reject(new Error('File gagal dibaca.'));reader.readAsDataURL(file);});}
function formObject(form){const o={};new FormData(form).forEach((v,k)=>{if(k!=='scan')o[k]=v;});return o;}
document.getElementById('incomingForm').addEventListener('submit',async e=>{e.preventDefault();const btn=document.getElementById('saveIncomingBtn');if(btn.disabled)return;btn.disabled=true;btn.textContent='Menyimpan…';try{const p=formObject(e.target);p.scan=await readFile(e.target.elements.scan.files[0]);p.clientRequestId=crypto.randomUUID?crypto.randomUUID():String(Date.now())+'-'+Math.random().toString(16).slice(2);const res=await serverCall('saveIncoming',p);if(res.duplicate){showNotice('Permintaan ini sudah diproses sebelumnya. Nomor registrasi: '+res.record.Nomor_Registrasi);return;}showNotice('Surat masuk berhasil dicatat dan dikirim ke Pengadministrasi Surat. Nomor registrasi: '+res.record.Nomor_Registrasi);e.target.reset();setTodayForwardDate();refreshAll();}catch(err){showNotice(err.message,'error');}finally{btn.disabled=false;btn.textContent='Simpan & Kirim ke Pengadministrasi';}});
document.getElementById('outgoingForm').addEventListener('submit',async e=>{e.preventDefault();const btn=document.getElementById('saveOutgoingBtn');btn.disabled=true;btn.textContent='Menyimpan…';try{const p=formObject(e.target);p.scan=await readFile(e.target.elements.scan.files[0]);p.clientRequestId=crypto.randomUUID?crypto.randomUUID():String(Date.now())+'-'+Math.random().toString(16).slice(2);const res=await serverCall('saveOutgoing',p);showNotice('Surat keluar berhasil disimpan. Nomor agenda: '+res.record.Nomor_Agenda_Internal);e.target.reset();refreshAll();}catch(err){showNotice(err.message,'error');}finally{btn.disabled=false;btn.textContent='Simpan surat keluar';}});
function applyFilters(){const q=(document.getElementById('searchQ')?.value||'').trim().toLocaleLowerCase('id');const rows=allIncoming.filter(r=>!q||['Nomor_Registrasi','Nomor_Surat','Asal_Surat','Perihal'].some(k=>String(r[k]||'').toLocaleLowerCase('id').includes(q)));renderIncoming(rows);}
function clearFilters(){const q=document.getElementById('searchQ');if(q)q.value='';renderIncoming(allIncoming);}
function clearFilters(){['searchQ','adminExactDate','adminFromDate','adminToDate'].forEach(id=>{const el=document.getElementById(id);if(el)el.value=''});if(document.getElementById('filterYear'))document.getElementById('filterYear').value='';if(document.getElementById('filterMonth'))document.getElementById('filterMonth').value='';renderIncoming(allIncoming);}
function loadIncoming(){serverCall('listIncoming',{limit:5000}).then(r=>{allIncoming=r;populateYears();applyFilters();applyIncomingRecap();applyCardRecap();}).catch(e=>showNotice(e.message,'error'));}
function loadOutgoing(){serverCall('listOutgoing',{limit:5000}).then(r=>{allOutgoing=r||[];renderOutgoing(allOutgoing);applyOutgoingRecap();}).catch(e=>showNotice(e.message,'error'));}
function filterByQueryDate(rows,q,date,from,to,dateKey,keys){q=(q||'').trim().toLocaleLowerCase('id');return rows.filter(r=>{const d=String(r[dateKey]||'');return (!q||keys.some(k=>String(r[k]||'').toLocaleLowerCase('id').includes(q)))&&(!date||d===date)&&(!from||d>=from)&&(!to||d<=to);});}
function applyIncomingRecap(){const rows=filterByQueryDate(allIncoming.filter(r=>String(r.Status||'')==='Diteruskan ke Kepala Dinas'),document.getElementById('riSearch')?.value,document.getElementById('riDate')?.value,document.getElementById('riFrom')?.value,document.getElementById('riTo')?.value,'Tanggal_Diterima',['Nomor_Registrasi','Nomor_Surat','Asal_Surat','Perihal']);renderIncoming(rows,'recapIncomingTable');}
function clearIncomingRecap(){['riSearch','riDate','riFrom','riTo'].forEach(id=>{const el=document.getElementById(id);if(el)el.value=''});applyIncomingRecap();}
function applyOutgoingRecap(){const rows=filterByQueryDate(allOutgoing,document.getElementById('roSearch')?.value,document.getElementById('roDate')?.value,document.getElementById('roFrom')?.value,document.getElementById('roTo')?.value,'Tanggal_Dicatat',['Nomor_Agenda_Internal','Nomor_Surat_Resmi','Tujuan_Surat','Perihal']);renderOutgoingTo(rows,'recapOutgoingTable');}
function clearOutgoingRecap(){['roSearch','roDate','roFrom','roTo'].forEach(id=>{const el=document.getElementById(id);if(el)el.value=''});applyOutgoingRecap();}
function applyCardRecap(){const rows=filterByQueryDate(allIncoming.filter(r=>String(r.Status||'')==='Diteruskan ke Kepala Dinas'),document.getElementById('rcSearch')?.value,document.getElementById('rcDate')?.value,document.getElementById('rcFrom')?.value,document.getElementById('rcTo')?.value,'Tanggal_Diterima',['Nomor_Registrasi','Nomor_Surat','Asal_Surat','Perihal']);renderCardRecap(rows);}
function clearCardRecap(){['rcSearch','rcDate','rcFrom','rcTo'].forEach(id=>{const el=document.getElementById(id);if(el)el.value=''});applyCardRecap();}
function renderOutgoingTo(rows,targetId){const el=document.getElementById(targetId);if(!el)return;if(!rows.length){el.innerHTML='<div class="empty">Belum ada surat keluar sesuai filter.</div>';return;}el.innerHTML='<table><thead><tr><th>Tanggal agenda</th><th>Nomor agenda</th><th>Nomor surat resmi</th><th>Tujuan</th><th>Perihal</th><th>Aksi</th></tr></thead><tbody>'+rows.map(r=>`<tr><td>${escapeHtml(formatDateStandard(r.Tanggal_Dicatat))}</td><td><b>${escapeHtml(r.Nomor_Agenda_Internal||'')}</b></td><td>${escapeHtml(r.Nomor_Surat_Resmi||'')}</td><td>${escapeHtml(r.Tujuan_Surat||'')}</td><td>${escapeHtml(r.Perihal||'')}</td><td><button class="secondary" onclick="openOutgoingScan('${escapeJs(r.ID_Surat)}')">Buka scan</button></td></tr>`).join('')+'</tbody></table>';}
function renderCardRecap(rows){const el=document.getElementById('recapCardTable');if(!el)return;if(!rows.length){el.innerHTML='<div class="empty">Belum ada Kartu Kendali untuk surat yang diteruskan ke Kepala Dinas.</div>';return;}el.innerHTML='<table><thead><tr><th>Tanggal diterima</th><th>Nomor registrasi</th><th>Asal surat</th><th>Nomor surat</th><th>Perihal</th><th>Tanggal diteruskan</th><th>Aksi</th></tr></thead><tbody>'+rows.map(r=>`<tr><td>${escapeHtml(r.Tanggal_Diterima||'')}</td><td><b>${escapeHtml(r.Nomor_Registrasi||'')}</b></td><td>${escapeHtml(r.Asal_Surat||'')}</td><td>${escapeHtml(r.Nomor_Surat||'')}</td><td>${escapeHtml(r.Perihal||'')}</td><td>${escapeHtml(r.Tanggal_Diteruskan||'')}</td><td><button onclick="printCardOnly('${escapeJs(r.ID_Surat)}')">Cetak Kartu Kendali</button></td></tr>`).join('')+'</tbody></table>';}
function formatDateStandard(value){const s=String(value||'').slice(0,10);const m=s.match(/^(\d{4})-(\d{2})-(\d{2})$/);return m?`${m[3]}:${m[2]}:${m[1]}`:s;}
function renderIncoming(rows,targetId='incomingTable'){const el=document.getElementById(targetId);if(!el)return;if(!rows.length){el.innerHTML='<div class="empty">Belum ada surat masuk sesuai filter.</div>';return;}el.innerHTML='<table><thead><tr><th>Tanggal diterima</th><th>Nomor registrasi</th><th>Asal surat</th><th>Nomor surat</th><th>Perihal</th><th>Status alur</th><th>Aksi</th></tr></thead><tbody>'+rows.map(r=>{const id=escapeJs(r.ID_Surat),st=String(r.Status||'Terkirim ke Pengadministrasi');let actions=`<button class="secondary" onclick="openScan('${id}')">Buka scan</button>`;if(currentRole==='ADMIN_SURAT'){actions+=` <button class="secondary" onclick="printCard('${id}')">Cetak ulang Disposisi + Kartu Kendali</button>`;if(st==='Terkirim ke Pengadministrasi'||st==='Menunggu pengadministrasi'||st==='Diterima pengadministrasi'){actions+=` <button onclick="startProcessAndPrint('${id}')">Mulai Proses & Cetak</button>`;}else if(st==='Diverifikasi dan Dicetak'||st==='Diproses'){actions+=` <button class="gold" onclick="forwardToHead('${id}')">Teruskan ke Kepala Dinas</button>`;}}return `<tr><td>${escapeHtml(formatDateStandard(r.Tanggal_Diterima))}<br><small>${escapeHtml((r.Waktu_Diterima||'').toString().slice(0,8)+' WITA')}</small></td><td><b>${escapeHtml(r.Nomor_Registrasi||'')}</b></td><td>${escapeHtml(r.Asal_Surat||'')}</td><td>${escapeHtml(r.Nomor_Surat||'')}</td><td>${escapeHtml(r.Perihal||'')}</td><td><span class="pill ${st==='Terkirim ke Pengadministrasi'?'':'status-updated'}">${escapeHtml(st)}</span></td><td>${actions}</td></tr>`;}).join('')+'</tbody></table>'; }
function renderOutgoing(rows){const el=document.getElementById('outgoingTable');if(!el)return;if(!rows.length){el.innerHTML='<div class="empty">Belum ada data surat keluar.</div>';return;}el.innerHTML='<table><thead><tr><th>Tanggal</th><th>Nomor agenda</th><th>Nomor surat</th><th>Tujuan</th><th>Perihal</th><th>Aksi</th></tr></thead><tbody>'+rows.map(r=>`<tr><td>${escapeHtml(formatDateStandard(r.Tanggal_Dicatat))}</td><td><b>${escapeHtml(r.Nomor_Agenda_Internal||'')}</b></td><td>${escapeHtml(r.Nomor_Surat_Resmi||'')}</td><td>${escapeHtml(r.Tujuan_Surat||'')}</td><td>${escapeHtml(r.Perihal||'')}</td><td><button class="secondary" onclick="openOutgoingScan('${escapeJs(r.ID_Surat)}')">Buka scan</button></td></tr>`).join('')+'</tbody></table>';}
function openOutgoingScan(id){serverCall('getScanUrl',id,'KELUAR').then(r=>window.open(r.url,'_blank','noopener')).catch(e=>showNotice(e.message,'error'));}
function openScan(id){serverCall('getScanUrl',id,'MASUK').then(r=>window.open(r.url,'_blank','noopener')).catch(e=>showNotice(e.message,'error'));}
async function startProcessAndPrint(id){if(!confirm('Mulai proses surat ini dan ubah status menjadi “Diverifikasi dan Dicetak”? Kartu Kendali Masuk dan Lembar Disposisi akan dibuka untuk dicetak.'))return;const w=window.open('about:blank','_blank');if(!w){showNotice('Izinkan pop-up browser untuk mencetak Kartu Kendali dan Lembar Disposisi.','error');return;}try{const r=await serverCall('updateIncomingStatus',id,'Diverifikasi dan Dicetak');const idx=allIncoming.findIndex(x=>x.ID_Surat===id);if(idx>=0)allIncoming[idx]=r.record;renderIncoming(allIncoming);applyIncomingRecap();applyCardRecap();if(currentRole==='FRONT_OFFICE')loadFoIncoming();w.document.write(printDocument(r.record));w.document.close();w.focus();setTimeout(()=>w.print(),500);showNotice('Status diperbarui menjadi Diverifikasi dan Dicetak. Periksa pratinjau cetak Kartu Kendali dan Lembar Disposisi.');}catch(e){w.close();showNotice(e.message,'error');}}
async function forwardToHead(id){if(!confirm('Konfirmasi surat ini diteruskan ke Kepala Dinas?'))return;try{const r=await serverCall('updateIncomingStatus',id,'Diteruskan ke Kepala Dinas');const idx=allIncoming.findIndex(x=>x.ID_Surat===id);if(idx>=0)allIncoming[idx]=r.record;renderIncoming(allIncoming);applyIncomingRecap();applyCardRecap();if(currentRole==='FRONT_OFFICE')loadFoIncoming();showNotice('Status surat berhasil diperbarui: Diteruskan ke Kepala Dinas.');}catch(e){showNotice(e.message,'error');}}
function startDirectScan(){showNotice('Mencoba membuka aplikasi pemindaian Windows. Jika aplikasi tidak terbuka, scan melalui aplikasi/driver scanner yang terpasang lalu pilih file hasil scan di kolom Hasil scan surat.');try{const a=document.createElement('a');a.href='ms-scan:';a.style.display='none';document.body.appendChild(a);a.click();a.remove();}catch(e){showNotice('Browser tidak dapat membuka aplikasi scan. Gunakan aplikasi scanner di komputer lalu pilih file hasil scan.','error');}}
function printMailRecap(period){
  const now=new Date(); const todayKey=localDateKey(now); let start=todayKey,end=todayKey,label='Hari Ini';
  if(period==='week'){const day=(now.getDay()+6)%7;const monday=new Date(now);monday.setDate(now.getDate()-day);const sunday=new Date(monday);sunday.setDate(monday.getDate()+6);start=localDateKey(monday);end=localDateKey(sunday);label='Minggu Ini';}
  if(period==='month'){start=todayKey.slice(0,8)+'01';const last=new Date(now.getFullYear(),now.getMonth()+1,0);end=localDateKey(last);label='Bulan Ini';}
  const inRows=(allIncoming||[]).filter(r=>{const d=String(r.Tanggal_Diterima||'').slice(0,10);return d>=start&&d<=end;});
  const outRows=currentRole==='ADMIN_SURAT'?(allOutgoing||[]).filter(r=>{const d=String(r.Tanggal_Dicatat||'').slice(0,10);return d>=start&&d<=end;}):[];
  const esc=v=>escapeHtml(v==null?'':String(v));
  const inTable=inRows.length?'<table><thead><tr><th>No.</th><th>Tanggal</th><th>Nomor Registrasi</th><th>Nomor Surat</th><th>Asal Surat</th><th>Perihal</th><th>Status</th></tr></thead><tbody>'+inRows.map((r,i)=>`<tr><td>${i+1}</td><td>${esc(r.Tanggal_Diterima)}</td><td>${esc(r.Nomor_Registrasi)}</td><td>${esc(r.Nomor_Surat)}</td><td>${esc(r.Asal_Surat)}</td><td>${esc(r.Perihal)}</td><td>${esc(r.Status)}</td></tr>`).join('')+'</tbody></table>':'<p>Tidak ada surat masuk pada periode ini.</p>';
  const outTable=currentRole==='ADMIN_SURAT'?'<h2>Surat Keluar</h2>'+(outRows.length?'<table><thead><tr><th>No.</th><th>Tanggal Agenda</th><th>Nomor Agenda</th><th>Nomor Surat</th><th>Tujuan</th><th>Perihal</th></tr></thead><tbody>'+outRows.map((r,i)=>`<tr><td>${i+1}</td><td>${esc(r.Tanggal_Dicatat)}</td><td>${esc(r.Nomor_Agenda_Internal)}</td><td>${esc(r.Nomor_Surat_Resmi)}</td><td>${esc(r.Tujuan_Surat)}</td><td>${esc(r.Perihal)}</td></tr>`).join('')+'</tbody></table>':'<p>Tidak ada surat keluar pada periode ini.</p>'):'';
  const w=window.open('','_blank');if(!w)return showNotice('Izinkan pop-up untuk mencetak rekap.','error');
  w.document.write('<!doctype html><html lang="id"><head><meta charset="utf-8"><title>Rekap Surat '+label+'</title><style>body{font:12px Arial;padding:18px;color:#111}h1{text-align:center;font-size:17px;margin:0}h2{font-size:14px;margin:18px 0 8px}p{margin:8px 0}table{width:100%;border-collapse:collapse;margin:10px 0 20px}th,td{border:1px solid #555;padding:5px;text-align:left;vertical-align:top}th{background:#eee} .meta{text-align:center;margin:7px 0 18px}@page{size:A4 landscape;margin:12mm}</style></head><body><h1>PEMERINTAH KABUPATEN TANAH LAUT</h1><h1>DINAS PEMBERDAYAAN MASYARAKAT DAN DESA</h1><div class="meta"><b>REKAPITULASI SURAT '+label.toUpperCase()+'</b><br>Periode: '+start+' s.d. '+end+'<br>Dicetak: '+new Date().toLocaleString('id-ID')+'</div><h2>Surat Masuk ('+inRows.length+')</h2>'+inTable+outTable+'</body></html>');w.document.close();w.focus();setTimeout(()=>w.print(),400);
}

function printOutgoingMonth(){
  const now=new Date(),start=localDateKey(new Date(now.getFullYear(),now.getMonth(),1)),end=localDateKey(new Date(now.getFullYear(),now.getMonth()+1,0));
  const rows=(allOutgoing||[]).filter(r=>String(r.Tanggal_Dicatat||'').slice(0,10)>=start&&String(r.Tanggal_Dicatat||'').slice(0,10)<=end);const esc=v=>escapeHtml(v==null?'':String(v));
  const table=rows.length?'<table><thead><tr><th>No.</th><th>Tanggal Agenda</th><th>Nomor Agenda</th><th>Nomor Surat</th><th>Tujuan</th><th>Perihal</th></tr></thead><tbody>'+rows.map((r,i)=>`<tr><td>${i+1}</td><td>${esc(r.Tanggal_Dicatat)}</td><td>${esc(r.Nomor_Agenda_Internal)}</td><td>${esc(r.Nomor_Surat_Resmi)}</td><td>${esc(r.Tujuan_Surat)}</td><td>${esc(r.Perihal)}</td></tr>`).join('')+'</tbody></table>':'<p>Tidak ada surat keluar bulan ini.</p>';
  const w=window.open('','_blank');if(!w)return showNotice('Izinkan pop-up untuk mencetak rekap.','error');w.document.write('<!doctype html><html><head><meta charset="utf-8"><title>Rekap Surat Keluar Bulan Ini</title><style>body{font:12px Arial;padding:18px;color:#111}h1{text-align:center;font-size:17px;margin:0}.meta{text-align:center;margin:8px 0 18px}table{width:100%;border-collapse:collapse}th,td{border:1px solid #555;padding:5px;text-align:left}th{background:#eee}@page{size:A4 landscape;margin:12mm}</style></head><body><h1>PEMERINTAH KABUPATEN TANAH LAUT</h1><h1>DINAS PEMBERDAYAAN MASYARAKAT DAN DESA</h1><div class="meta"><b>REKAP SURAT KELUAR BULAN INI</b><br>Periode: '+start+' s.d. '+end+'</div>'+table+'</body></html>');w.document.close();w.focus();setTimeout(()=>w.print(),400);
}
function printCardOnly(id){const r=allIncoming.find(x=>x.ID_Surat===id);if(!r)return showNotice('Data tidak ditemukan pada daftar saat ini.','error');const w=window.open('','_blank');if(!w)return showNotice('Izinkan pop-up untuk mencetak.','error');const val=k=>escapeHtml(r[k]||'');w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>Kartu Kendali ${val('Nomor_Registrasi')}</title><style>@page{size:A4 portrait;margin:15mm}*{box-sizing:border-box}body{font:11px Arial;color:#111;margin:0}h1{text-align:center;font-size:15px;margin:0 0 12px}table{border-collapse:collapse;width:100%;table-layout:fixed}td{border:1px solid #333;padding:8px;vertical-align:top;overflow-wrap:anywhere}.vertical{writing-mode:vertical-rl;transform:rotate(180deg);text-align:center;font-weight:bold;font-size:10px}.small{font-size:9px}</style></head><body><h1>KARTU KENDALI SURAT MASUK<br>DINAS PEMBERDAYAAN MASYARAKAT DAN DESA<br>KABUPATEN TANAH LAUT</h1><table><tr><td rowspan="6" class="vertical" style="width:9%">DINAS PEMBERDAYAAN MASYARAKAT DAN DESA<br>KABUPATEN TANAH LAUT<br>KARTU KENDALI MASUK</td><td style="width:18%">Indeks</td><td style="width:28%"></td><td style="width:15%">Kode</td><td></td><td>Nomor Urut: ${val('Nomor_Urut_Kartu')}</td></tr><tr><td>Isi Ringkas</td><td colspan="4" style="height:55px">${val('Isi_Ringkas')||val('Perihal')}</td></tr><tr><td>Dari</td><td colspan="4">${val('Asal_Surat')}</td></tr><tr><td>Tanggal Surat</td><td>${val('Tanggal_Surat')}</td><td colspan="2">Nomor Surat</td><td>${val('Nomor_Surat')}</td></tr><tr><td>Pengolah</td><td>${val('Pengolah')}</td><td colspan="2">Tanggal diteruskan</td><td>${val('Tanggal_Diteruskan')||UtilitiesTodayFallback()}</td></tr><tr><td>Catatan</td><td colspan="4" style="height:65px">${val('Catatan')}</td></tr><tr><td colspan="6" class="small">Nomor registrasi LINTAS: ${val('Nomor_Registrasi')} | Tanggal diterima: ${val('Tanggal_Diterima')} ${val('Waktu_Diterima')}</td></tr></table></body></html>`);w.document.close();w.focus();setTimeout(()=>w.print(),400);}

function localDateKey(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
function printCard(id){const r=allIncoming.find(x=>x.ID_Surat===id);if(!r)return showNotice('Data tidak ditemukan pada daftar saat ini.','error');const w=window.open('','_blank');if(!w)return showNotice('Izinkan pop-up untuk mencetak.','error');w.document.write(printDocument(r));w.document.close();w.focus();setTimeout(()=>w.print(),500);}
function printDocument(r){const val=k=>escapeHtml(r[k]||'');return `<!doctype html><html><head><meta charset="utf-8"><title>Lembar Disposisi dan Kartu Kendali ${val('Nomor_Registrasi')}</title><style>@page{size:A4 portrait;margin:7mm}*{box-sizing:border-box}body{font:8.5px Arial;color:#111;margin:0}h1,h2,h3,p{margin:0}table{border-collapse:collapse;width:100%;table-layout:fixed}td,th{border:1px solid #333;padding:3px;vertical-align:top;overflow-wrap:anywhere}.center{text-align:center}.head{font-weight:bold;font-size:11px}.small{font-size:7px}.logo{width:34px;height:34px;object-fit:contain}.dispo{height:30px}.cut{border-top:1px dashed #555;margin:4px 0}.section{margin-bottom:5px}.cardtitle{font-weight:bold;font-size:10px;letter-spacing:.3px}.disposition-title{font-size:11px;font-weight:bold;text-align:center;padding:4px}.label{font-weight:bold}.writebox{height:48px}.checks{line-height:1.6}.vertical{writing-mode:vertical-rl;transform:rotate(180deg);text-align:center;font-weight:bold;letter-spacing:.3px}.no-break{break-inside:avoid;page-break-inside:avoid}</style></head><body>
<div class="section no-break"><table><tr><td style="width:14%;text-align:center"><img class="logo" src="${LOGO_TANAH_LAUT}" alt="Lambang Kabupaten Tanah Laut"></td><td class="center"><div class="head">PEMERINTAH KABUPATEN TANAH LAUT</div><div class="head">DINAS PEMBERDAYAAN MASYARAKAT DAN DESA</div><div class="disposition-title">LEMBAR DISPOSISI</div></td><td style="width:14%;text-align:center"><img class="logo" src="${LOGO_DPMD}" alt="Logo DPMD"></td></tr></table>
